# ==================== ОБЯЗАТЕЛЬНЫЕ ====================

# Токен бота (получить у @BotFather)
BOT_TOKEN=

# Юзернейм бота (без @)
BOT_USERNAME=your_bot_username

# ==================== БАЗА ДАННЫХ ====================

DB_HOST=postgres
DB_PORT=5432
DB_NAME=bot_4_wallpaper
DB_USER=bot_4_wallpaper
DB_PASSWORD=

# ==================== АДМИНЫ ====================

# Telegram ID админов через запятую
ADMIN_IDS=
ADMIN_USERNAME=admin

# ==================== WALLHAVEN API ====================

# API-ключ Wallhaven (опционально — без него только SFW обои, лимит 45 req/min)
# Получить на https://wallhaven.cc/settings/account
WALLHAVEN_API_KEY=

# ==================== НАСТРОЙКИ ОБОЕВ ====================

# Разрешение по умолчанию для новых пользователей
DEFAULT_RESOLUTION=1920x1080

# ==================== LOCAL BOT API (опционально) ====================

# Нужен только если файлы обоев > 50 МБ (редко актуально для wallpaper-бота)
# API_ID=           # получить на https://my.telegram.org
# API_HASH=         # получить на https://my.telegram.org
# LOCAL_BOT_API_URL=http://bot-api:8081

# ==================== КЭШ ====================

# Время жизни кэша обоев в БД (дни)
CACHE_TTL_DAYS=7
